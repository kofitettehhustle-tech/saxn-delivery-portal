# Browser-visible Supabase configuration (anon key is intended for clients; RLS must remain enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only credentials — never rename these with NEXT_PUBLIC_ or commit real values
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DELIVERY_COOKIE_SECRET=replace_with_at_least_32_random_bytes_in_hex

# Private Supabase buckets created by database/migrations/001_initial_schema.sql
SUPABASE_BUCKET_ORIGINALS=delivery-originals
SUPABASE_BUCKET_ARCHIVES=delivery-archives
SUPABASE_BUCKET_PREVIEWS=delivery-previews
SUPABASE_BUCKET_BRAND=brand-assets

# Fallback limits (database storage_settings are authoritative after migrations are applied)
MAX_UPLOAD_BYTES=2147483648
MAX_DELIVERY_BYTES=10737418240
SIGNED_URL_TTL_SECONDS=120
PUBLIC_RATE_LIMIT_PER_MINUTE=30
MAX_PROCESSING_ATTEMPTS=3

# Separate Node.js worker settings
WORKER_POLL_INTERVAL_MS=3000
WORKER_STALE_SECONDS=900
WORKER_HEALTH_PORT=8787
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Canonical HTTPS site origin for private delivery links; required if Vercel system variables are disabled
PUBLIC_APP_URL=

# Short.io server-side link creation; keep the API key secret and domain host-only (no scheme/path)
SHORTIO_API_KEY=
SHORTIO_DOMAIN=
